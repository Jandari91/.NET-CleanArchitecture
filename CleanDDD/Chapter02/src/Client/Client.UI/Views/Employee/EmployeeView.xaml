<UserControl
    x:Class="Client.UI.Views.Employee.EmployeeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atoms="clr-namespace:Client.UI.Components.Atoms"
    xmlns:converters="clr-namespace:Client.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Client.UI.Views.Employee"
    xmlns:markup="clr-namespace:Client.UI.Abstractions.Markups"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Client.Presentation.ViewModels.Employee;assembly=Client.Presentation"
    d:DataContext="{d:DesignInstance {x:Type vm:EmployeeViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{markup:DependencySource Type=vm:EmployeeViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <Grid Margin="16">

        <atoms:Button
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="999"
            Command="{Binding LoadEmployeesCommand}"
            Icon="{ui:SymbolIcon ArrowSync12}" />

        <DataGrid
            AutoGenerateColumns="False"
            IsEnabled="{Binding LoadEmployeesCommand.IsRunning, Converter={StaticResource InverseBooleanConverter}}"
            ItemsSource="{Binding Employees, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Header="Name" />
                <DataGridTextColumn Binding="{Binding Email}" Header="Email" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
