<ui:FluentWindow
    x:Class="Client.UI.Components.Molecules.ExceptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="clr-namespace:Client.UI.Components.Atoms"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Client.UI.Components.Molecules"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="Exception Dialog"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True" />
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Label
                    Content="Message"
                    DockPanel.Dock="Top"
                    FontSize="60"
                    FontWeight="Bold" />
                <TextBox
                    x:Name="ExMessage"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <Label
                    Content="Exception Stack Trace"
                    DockPanel.Dock="Top"
                    FontSize="60"
                    FontWeight="Bold" />
                <TextBox
                    x:Name="ExTrace"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    TextWrapping="Wrap" />
            </DockPanel>


        </Grid>

        <Grid Grid.Row="2" Margin="8">
            <atom:Button
                Width="80"
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="Button_Click"
                Content="확인" />
        </Grid>
    </Grid>
</ui:FluentWindow>
