<ui:FluentWindow
    x:Class="Client.UI.Components.Molecules.ContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Client.UI.Components.Molecules"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="WindowName"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ExtendsContentIntoTitleBar="True"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="85" />
            </Grid.RowDefinitions>

            <ui:TitleBar
                x:Name="titleBarName"
                Grid.Row="0"
                Margin="1"
                CloseWindowByDoubleClickOnIcon="True">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon x:Name="titleIcon" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentPresenter
                        x:Name="ContentPanel"
                        Margin="8,8,12,8"
                        Content="{Binding}" />
                </ScrollViewer>
            </Grid>

            <StackPanel
                x:Name="ButtonPanel"
                Grid.Row="2"
                Margin="8,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal" />
        </Grid>

        <ui:SnackbarPresenter
            x:Name="snackPresenter"
            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100" />
    </Grid>
</ui:FluentWindow>
